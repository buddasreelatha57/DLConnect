# These are environment variables required by the default (non-local) profile.
DATABASE_URL=jdbc:postgresql://localhost:5432/kaam_connect
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=https://your-web-domain.example,capacitor://localhost,https://localhost
